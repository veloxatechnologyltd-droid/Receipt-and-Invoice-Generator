# Database URL (Neon PostgreSQL). On Vercel use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@hostname.neon.tech/dbname?sslmode=require

# JWT Secret Key (generate a strong random string: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Local development only: allowed frontend origins (comma-separated).
# Not needed on Vercel, where frontend and API share one domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
